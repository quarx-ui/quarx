{
  "name": "quarx",
  "version": "0.0.1",
  "description": "Design kit for Sber ecosystem",
  "license": "Sber Public License at-nc-sa",
  "private": true,
  "packageManager": "bun@1.3.8",
  "scripts": {
    "build": "lerna exec --parallel 'bun run build'",
    "publish": "lerna version && lerna run publish",
    "publish:ci": "lerna version --yes && lerna run publish",
    "lint": "tsc --noEmit --emitDeclarationOnly false && bun run lint:imports && eslint 'packages/**' --ignore-pattern '**/build/**'",
    "lint:fix": "bun run lint --fix",
    "lint:branch": "tsc --noEmit --emitDeclarationOnly false && bun run lint:imports && eslint $(git diff --diff-filter=d --name-only origin..) --ignore-pattern '**/build/**'",
    "lint:branch-fix": "bun run lint:branch --fix",
    "lint:staged": "tsc --noEmit --emitDeclarationOnly false && bun run lint:imports && eslint $(git diff --diff-filter=d  --cached --name-only) --ignore-pattern '**/build/**'",
    "lint:staged-fix": "bun run lint:staged --fix",
    "lint:imports": "bun run madge --circular --extensions ts,tsx . --exclude 'build|storybook-static'",
    "test:u": "bun run test:jest:u",
    "storybook:set-env": "BABEL_ENV=storybook",
    "story": "bun run storybook",
    "storybook": "BABEL_ENV=storybook WATCHPACK_POLLING=true storybook dev -p 6006",
    "storybook:build": "BABEL_ENV=storybook storybook build",
    "storybook:publish": "bun run storybook:build && node ./.storybook/publish.js",
    "test:jest": "BABEL_ENV=test lerna exec 'bun run jest --passWithNoTests'",
    "test:jest:u": "BABEL_ENV=test lerna exec 'bun run jest --passWithNoTests -u'",
    "test": "bun run test:jest",
    "test:all": "bun run test",
    "test:all:u": "bun run test:jest:u",
    "ci:figma:icons": "cd ./scripts/figma && bun run update:icons",
    "new": "ts-node scripts/cli/new"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@babel/cli": "^7.15.7",
    "@babel/core": "^7.15.5",
    "@babel/preset-env": "^7.15.6",
    "@babel/preset-react": "^7.14.5",
    "@babel/preset-typescript": "^7.15.0",
    "@emotion/babel-preset-css-prop": "^11.2.0",
    "@emotion/react": "^11.7.1",
    "@emotion/serialize": "^1.0.2",
    "@emotion/styled": "^11.6.0",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-links": "10.4.6",
    "@storybook/icons": "2.0.2",
    "@storybook/react-vite": "10.4.6",
    "@testing-library/jest-dom": "^5.16.2",
    "@testing-library/react": "^12.1.3",
    "@testing-library/user-event": "^13.5.0",
    "@types/bluebird": "3.5.36",
    "@types/inquirer": "^8.0.0",
    "@types/jest": "^27.0.1",
    "@types/node": "^14.14.41",
    "@types/react": "17.0.93",
    "@types/react-dom": "17.0.26",
    "@typescript-eslint/eslint-plugin": "^5.9.1",
    "@typescript-eslint/parser": "^5.9.1",
    "aws-sdk": "^2.913.0",
    "axios": "^0.21.4",
    "babel-core": "^6.26.3",
    "babel-jest": "^27.5.1",
    "babel-plugin-css-modules-transform": "^1.6.2",
    "babel-plugin-inline-import-data-uri": "^1.0.1",
    "babel-plugin-inline-react-svg": "^2.0.1",
    "babel-plugin-module-resolver": "^4.1.0",
    "change-case": "4.1.2",
    "commander": "^9.0.0",
    "conventional-changelog-conventionalcommits": "^4.6.1",
    "dotenv": "16.0.0",
    "eslint": "^8.6.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-import-resolver-typescript": "^2.5.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jest": "^25.3.4",
    "eslint-plugin-json": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "eslint-plugin-storybook": "10.4.6",
    "figma-api": "1.6.2",
    "inquirer": "^8.0.0",
    "jest": "^27.2.0",
    "jest-environment-jsdom": "^27.5.1",
    "jest-environment-jsdom-sixteen": "^2.0.0",
    "lerna": "^4.0.0",
    "madge": "6.1.0",
    "mime-types": "^2.1.30",
    "mock-match-media": "^0.4.2",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "storybook": "10.4.6",
    "ts-node": "^10.2.1",
    "tslib": "2.3.1",
    "typescript": "5.8.3",
    "vite": "8.1.0",
    "vite-plugin-svgr": "5.2.0"
  },
  "resolutions": {
    "es5-ext": "0.10.53"
  }
}
